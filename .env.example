# NEXUS Configuration Example
# ============================
# Copy this file to .env and customize

# =============================================================================
# V11.3 SECURITY (REQUIRED FOR PRODUCTION)
# =============================================================================
# JWT Secret - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEXUS_JWT_SECRET=your_secure_secret_here

# CORS Origins - Comma-separated list of allowed origins
# NEXUS_CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# =============================================================================
# V11.6 KEYMAKER - Authentication (REQUIRED FOR PRODUCTION)
# =============================================================================
# Admin password for login endpoint
# IMPORTANT: Change this in production! Default is "nexus" which is INSECURE.
# NEXUS_ADMIN_PASSWORD=your_secure_admin_password

# =============================================================================
# VERSION (Single Source of Truth)
# =============================================================================
NEXUS_VERSION=8.3.1
NEXUS_CODENAME=TRUE HIVE MIND

# CLI Paths
GEMINI_CLI_PATH=gemini
CLAUDE_CLI_PATH=claude

# Orchestration
MAX_STALEMATE_COUNT=5
STAGNATION_SIMILARITY_THRESHOLD=0.8
WORKSPACE_PATH=./workspace
NEXUS_ROOT=.
LOG_LEVEL=INFO
UI_VERBOSE=False

# API Keys (DO NOT COMMIT REAL VALUES)
# GEMINI_API_KEY=your_key_here

# Evolution
MAX_GEN_PER_DAY=10
MIN_HOURS_BETWEEN_GEN=0.1

# Swarm
SWARM_ENABLED=True
SWARM_AUTO_ROUTE=True
SWARM_NEGOTIATION=True
SWARM_SELF_HEALING=True

# HiveMind
HIVE_MIND_ENABLED=True
FAST_PATH_ENABLED=True

# Memory
# Options: auto (recommended) | dense | bm25 | tfidf
# auto = Dense > BM25S > TF-IDF (best available)
PROJECT_MEMORY_BACKEND=auto
# Maximum chunks indexed per project (safety cap enforced at 50k)
PROJECT_MEMORY_MAX_CHUNKS=5000

# Telemetry / Observability (optional)
TELEMETRY_ENABLED=True
TELEMETRY_FILE=workspace/telemetry.jsonl

# Red Team (V8.2.0c)
REDTEAM_SPAWN_ENABLED=True
REDTEAM_SPAWN_BLOCK=False
