# NEXUS Configuration Example
# ============================
# Copy this file to .env and customize

# VERSION (Single Source of Truth)
NEXUS_VERSION=10.0
NEXUS_CODENAME=Singularity

# SECURITY (V10 - KERNEL integrity)
# Compute with: python -c "import hashlib; print(hashlib.sha256(open('KERNEL.py', 'rb').read()).hexdigest())"
NEXUS_KERNEL_HASH=0f9ac97d2843dc78ee6df0fcf221fedd4cfc55e43e4420a2a33f45e60f8c2873

# CLI Paths
GEMINI_CLI_PATH=gemini
CLAUDE_CLI_PATH=claude

# Orchestration
MAX_STALEMATE_COUNT=5
STAGNATION_SIMILARITY_THRESHOLD=0.8
WORKSPACE_PATH=./workspace
LOG_LEVEL=INFO
UI_VERBOSE=False

# API Keys (DO NOT COMMIT REAL VALUES)
# GEMINI_API_KEY=your_key_here

# Evolution
MAX_GEN_PER_DAY=10
MIN_HOURS_BETWEEN_GEN=0.1

# Swarm
SWARM_ENABLED=True
SWARM_AUTO_ROUTE=True
SWARM_NEGOTIATION=True
SWARM_SELF_HEALING=True

# HiveMind
HIVE_MIND_ENABLED=True
FAST_PATH_ENABLED=True

# Memory
PROJECT_MEMORY_BACKEND=tfidf

# Red Team (V8.2.0c)
REDTEAM_SPAWN_ENABLED=True
REDTEAM_SPAWN_BLOCK=False
