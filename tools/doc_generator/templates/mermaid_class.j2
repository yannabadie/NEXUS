classDiagram
{% for cls in classes %}
    class {{ cls.name }} {
{% for attr in cls.attributes %}
        {{ attr.visibility }}{{ attr.type }} {{ attr.name }}
{% endfor %}
{% for method in cls.methods %}
        {{ method.visibility }}{{ method.name }}({{ method.params }}){% if method.return_type %} {{ method.return_type }}{% endif %}

{% endfor %}
    }
{% if cls.bases %}
{% for base in cls.bases %}
    {{ base }} <|-- {{ cls.name }}
{% endfor %}
{% endif %}
{% endfor %}

{% for rel in relationships %}
    {{ rel.from }} {{ rel.type }} {{ rel.to }}{% if rel.label %} : {{ rel.label }}{% endif %}

{% endfor %}
