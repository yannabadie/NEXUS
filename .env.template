# NEXUS V6 - Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# EMAIL NOTIFICATIONS (Outlook SMTP)
# =============================================================================

# Email enabled by default
EMAIL_ENABLED=True

# Outlook SMTP Configuration
SMTP_SERVER=smtp-mail.outlook.com
SMTP_PORT=587
EMAIL_FROM=yann.abadie@outlook.com
EMAIL_TO=yann.abadie@outlook.com

# IMPORTANT: Set your Outlook password here
# For security, use an App Password (not your main password)
# Generate App Password: https://account.microsoft.com/security
NEXUS_EMAIL_PASSWORD=your_outlook_password_here

# =============================================================================
# EVOLUTION PARAMETERS (Override defaults if needed)
# =============================================================================

# Max children per generation (default: 3 for MVP, 10 for stable)
# MAX_CHILDREN_CONCURRENT=3
# MAX_CHILDREN_STABLE=10
# STABLE_MODE_THRESHOLD=5

# Rate limiting (default: 3 generations/day)
# MAX_GEN_PER_DAY=3
# MIN_HOURS_BETWEEN_GEN=8

# Evaluation timeline (default: 48h recommended)
# MIN_EVAL_HOURS=24
# RECOMMENDED_EVAL_HOURS=48
# CRITICAL_REVIEW_HOURS=72

# Auto-evolution trigger (default: after 50 REPL turns)
# REPL_TURNS_TRIGGER=50

# =============================================================================
# OPTIONAL NOTIFICATIONS
# =============================================================================

# Desktop notifications (Windows toast)
# DESKTOP_NOTIF=False

# Webhook URL (Discord/Slack)
# WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# =============================================================================
# RED TEAM TESTING
# =============================================================================

# Red Team frequency (default: every 5 generations)
# RED_TEAM_FREQ=5

# Fail threshold (default: 2 failed traps = termination)
# RED_TEAM_FAIL_THRESHOLD=2

# =============================================================================
# CLI PATHS (Override if needed)
# =============================================================================

# Gemini CLI path (default: "gemini")
# GEMINI_CLI_PATH=gemini

# Claude CLI path (default: "claude")
# CLAUDE_CLI_PATH=claude

# =============================================================================
# LOGGING
# =============================================================================

# Log level (default: INFO)
# LOG_LEVEL=INFO

# Verbose UI (default: False)
# UI_VERBOSE=False
